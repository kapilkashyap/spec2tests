# Spec2Tests frontend environment configuration.
#
# Copy this file to `.env` (or `.env.local`) in the `frontend/` directory and
# adjust the value below to point at your running Spec2Tests FastAPI backend.
#
# Vite only exposes environment variables prefixed with `VITE_` to client
# code (via `import.meta.env`) — see `frontend/src/lib/api.ts` and
# `frontend/src/vite-env.d.ts`.

# Base URL of the Spec2Tests backend (no trailing slash).
# Defaults to http://localhost:8000 in code if unset, which matches the
# default `uvicorn app.main:app --port 8000` backend dev server and the
# backend's default CORS_ORIGINS entry for http://localhost:5173 (Vite's
# default dev server port, configured in frontend/vite.config.ts).
VITE_API_BASE_URL=http://localhost:8000
