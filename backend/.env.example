# Spec2Tests backend — environment configuration
#
# Copy this file to `.env` (in this `backend/` directory) and fill in the
# values for your environment. `backend/app/config.py` loads `.env` via
# python-dotenv on process startup; values already present in the shell/CI
# environment always take precedence over this file.
#
#   cp .env.example .env

# --- Application -----------------------------------------------------------

# Human-readable application name (used in logs/docs). Optional.
APP_NAME=Spec2Tests

# Deployment environment identifier: development | staging | production
APP_ENV=development

# Enable verbose debug behaviour (FastAPI docs, detailed error responses).
# Accepted truthy values: 1, true, yes, on (case-insensitive).
DEBUG=true

# Host/port the Uvicorn server binds to.
HOST=0.0.0.0
PORT=8000

# --- CORS --------------------------------------------------------------------

# Comma-separated list of allowed CORS origins for the frontend SPA.
# Defaults to the Vite dev server origin if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Gemini -------------------------------------------------------

# Required for test case generation to function. Obtain a key from
# https://ai.google.dev/ (Google AI Studio) and paste it below. Never commit
# a real key to version control.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini model used for test case generation.
GEMINI_MODEL=YOU_GEMINI_MODEL_HERE

# --- File upload limits -------------------------------------------------------

# Maximum accepted upload size per file, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Comma-separated list of accepted BRD/FRD document file extensions.
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt

# --- Logging -----------------------------------------------------------------

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
